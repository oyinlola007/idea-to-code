{
  "name": "idea-to-code-format-spike",
  "private": true,
  "type": "module",
  "description": "ITC-2 spike: prove the plan file format before product code depends on it.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "tsx src/cli/validate.ts",
    "layout": "tsx layout/render.ts",
    "harness:claude": "tsx harness/claude.ts",
    "harness:builtin": "node --env-file-if-exists=.env --import tsx harness/builtin.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@ai-sdk/openai": "^4.0.101",
    "ai": "^7.0.150",
    "elkjs": "^0.12.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
