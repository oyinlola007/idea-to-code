{
  "name": "idea-to-code",
  "displayName": "idea-to-code",
  "description": "Plan software as nested flowcharts, with any coding agent.",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "publisher": "idea-to-code",
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [
    "workspaceContains:plan/map.yaml",
    "onWebviewPanel:ideaToCode.app"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ideaToCode",
          "title": "Plan",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "ideaToCode": [
        {
          "id": "ideaToCode.features",
          "name": "Features"
        },
        {
          "id": "ideaToCode.sessions",
          "name": "Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ideaToCode.features",
        "contents": "No plan in this workspace yet.\n[Initialize Plan](command:ideaToCode.initPlan)",
        "when": "workspaceFolderCount > 0 && isWorkspaceTrusted && !ideaToCode.hasPlan"
      },
      {
        "view": "ideaToCode.features",
        "contents": "No plan in this folder. Trust the folder to create one: Restricted Mode is view-only.",
        "when": "workspaceFolderCount > 0 && !isWorkspaceTrusted && !ideaToCode.hasPlan"
      },
      {
        "view": "ideaToCode.features",
        "contents": "Open a folder to plan it.\n[Open Folder](command:vscode.openFolder)",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "ideaToCode.features",
        "contents": "This plan has no features yet.\n[Open Plan](command:ideaToCode.openApp)",
        "when": "ideaToCode.hasPlan"
      },
      {
        "view": "ideaToCode.sessions",
        "contents": "No sessions yet. They appear here as the plan changes.",
        "when": "isWorkspaceTrusted"
      },
      {
        "view": "ideaToCode.sessions",
        "contents": "History isn't recorded in Restricted Mode.",
        "when": "!isWorkspaceTrusted"
      }
    ],
    "customEditors": [
      {
        "viewType": "ideaToCode.planEditor",
        "displayName": "Plan chart",
        "selector": [
          {
            "filenamePattern": "**/plan/map.yaml"
          },
          {
            "filenamePattern": "**/plan/features/*.yaml"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "ideaToCode.openApp",
        "title": "Open Plan",
        "category": "idea-to-code",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "ideaToCode.initPlan",
        "title": "Initialize Plan in This Workspace",
        "category": "idea-to-code",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "ideaToCode.openModelSettings",
        "title": "Model Settings",
        "category": "idea-to-code",
        "icon": "$(settings-gear)",
        "enablement": "isWorkspaceTrusted && ideaToCode.hasPlan"
      },
      {
        "command": "ideaToCode.showHistory",
        "title": "Show History",
        "category": "idea-to-code",
        "icon": "$(history)",
        "enablement": "isWorkspaceTrusted && ideaToCode.hasPlan"
      },
      {
        "command": "ideaToCode.reopenAsText",
        "title": "Reopen as Text",
        "category": "idea-to-code",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ideaToCode.openPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "idea-to-code",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ideaToCode.openPreviewToSide",
          "when": "resourcePath =~ /[\\\\/]plan[\\\\/](map\\.yaml|features[\\\\/][^\\\\/]+\\.yaml)$/ && activeCustomEditorId != ideaToCode.planEditor",
          "group": "navigation"
        },
        {
          "command": "ideaToCode.reopenAsText",
          "when": "activeCustomEditorId == ideaToCode.planEditor",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "ideaToCode.openApp",
          "when": "view == ideaToCode.features && ideaToCode.hasPlan",
          "group": "navigation"
        },
        {
          "command": "ideaToCode.showHistory",
          "when": "view == ideaToCode.sessions && ideaToCode.hasPlan && isWorkspaceTrusted",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "idea-to-code",
      "properties": {
        "ideaToCode.models.source": {
          "type": "string",
          "enum": [
            "editor",
            "key"
          ],
          "default": "editor",
          "scope": "application",
          "description": "Where the built-in chat gets its models. Without any models in your editor, your own API key is used."
        },
        "ideaToCode.models.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai",
            "google",
            "custom"
          ],
          "default": "anthropic",
          "scope": "application",
          "description": "Which provider your own API key is for."
        },
        "ideaToCode.models.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "The address of a custom OpenAI-compatible endpoint. User settings only, so a project can't redirect your key."
        },
        "ideaToCode.models.tiers": {
          "type": "object",
          "default": {},
          "scope": "application",
          "description": "The main and small model chosen for each provider."
        },
        "ideaToCode.planFiles.openAs": {
          "type": "string",
          "enum": [
            "chart",
            "text"
          ],
          "default": "chart",
          "description": "How plan files open: as a chart, or as text."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node esbuild.mjs",
    "test:ext": "tsx scripts/run-ext-tests.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.93",
    "@ai-sdk/google": "4.0.109",
    "@ai-sdk/openai": "4.0.106",
    "@ai-sdk/openai-compatible": "3.0.82",
    "@idea-to-code/core": "workspace:*",
    "@idea-to-code/store": "workspace:*",
    "ai": "7.0.158",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@idea-to-code/webview": "workspace:*",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode plans are view-only and no history is recorded. Trust the folder to turn everything on."
    }
  }
}
