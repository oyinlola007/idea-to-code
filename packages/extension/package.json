{
  "name": "idea-to-code",
  "displayName": "idea-to-code",
  "description": "Plan software as nested flowcharts, with your coding agent.",
  "version": "1.0.3",
  "publisher": "oyinlola-ojelere",
  "author": "Oyinlola Ojelere",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1a5fc4",
    "theme": "dark"
  },
  "categories": [
    "Visualization",
    "AI",
    "Chat"
  ],
  "keywords": [
    "plan",
    "planning",
    "flowchart",
    "diagram",
    "architecture",
    "mcp",
    "agent",
    "claude",
    "copilot",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola007/idea-to-code.git",
    "directory": "packages/extension"
  },
  "homepage": "https://github.com/oyinlola007/idea-to-code#readme",
  "bugs": {
    "url": "https://github.com/oyinlola007/idea-to-code/issues"
  },
  "private": true,
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "workspaceContains:plan/map.yaml",
    "onWebviewPanel:ideaToCode.app",
    "onView:ideaToCode.chat"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ideaToCode",
          "title": "Plan",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "ideaToCode": [
        {
          "type": "webview",
          "id": "ideaToCode.chat",
          "name": "Chat"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "ideaToCode.planEditor",
        "displayName": "Plan chart",
        "selector": [
          {
            "filenamePattern": "**/plan/map.yaml"
          },
          {
            "filenamePattern": "**/plan/features/*.yaml"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "ideaToCode.openApp",
        "title": "Open Plan",
        "category": "idea-to-code",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "ideaToCode.exportWebPage",
        "title": "Export as Web Page",
        "category": "idea-to-code"
      },
      {
        "command": "ideaToCode.initPlan",
        "title": "Initialize Plan in This Workspace",
        "category": "idea-to-code",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "ideaToCode.openSettings",
        "title": "Settings",
        "category": "idea-to-code",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ideaToCode.showHistory",
        "title": "Show History",
        "category": "idea-to-code",
        "icon": "$(history)",
        "enablement": "isWorkspaceTrusted && ideaToCode.hasPlan"
      },
      {
        "command": "ideaToCode.reopenAsText",
        "title": "Reopen as Text",
        "category": "idea-to-code",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ideaToCode.openPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "idea-to-code",
        "icon": "$(open-preview)"
      },
      {
        "command": "ideaToCode.newChat",
        "title": "New Chat",
        "category": "idea-to-code",
        "icon": "$(add)"
      },
      {
        "command": "ideaToCode.openChat",
        "title": "Previous Chats",
        "category": "idea-to-code",
        "icon": "$(history)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ideaToCode.openPreviewToSide",
          "when": "resourcePath =~ /[\\\\/]plan[\\\\/](map\\.yaml|features[\\\\/][^\\\\/]+\\.yaml)$/ && activeCustomEditorId != ideaToCode.planEditor",
          "group": "navigation"
        },
        {
          "command": "ideaToCode.reopenAsText",
          "when": "activeCustomEditorId == ideaToCode.planEditor",
          "group": "navigation"
        },
        {
          "command": "ideaToCode.exportWebPage",
          "when": "activeWebviewPanelId == 'ideaToCode.app' || activeCustomEditorId == ideaToCode.planEditor",
          "group": "1_share"
        }
      ],
      "view/title": [
        {
          "command": "ideaToCode.openApp",
          "when": "view == ideaToCode.chat && ideaToCode.hasPlan && !ideaToCode.planVisible && !ideaToCode.settingsShown",
          "group": "navigation@0"
        },
        {
          "command": "ideaToCode.newChat",
          "when": "view == ideaToCode.chat && ideaToCode.hasPlan && isWorkspaceTrusted && !ideaToCode.settingsShown",
          "group": "navigation@1"
        },
        {
          "command": "ideaToCode.openChat",
          "when": "view == ideaToCode.chat && ideaToCode.hasPlan && isWorkspaceTrusted && !ideaToCode.settingsShown",
          "group": "navigation@2"
        },
        {
          "command": "ideaToCode.openSettings",
          "when": "view == ideaToCode.chat",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "idea-to-code",
      "properties": {
        "ideaToCode.models.source": {
          "type": "string",
          "enum": [
            "editor",
            "key"
          ],
          "default": "editor",
          "scope": "application",
          "description": "Where the built-in chat gets its models. Without any models in your editor, your own API key is used."
        },
        "ideaToCode.models.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai",
            "google",
            "custom"
          ],
          "default": "anthropic",
          "scope": "application",
          "description": "Which provider your own API key is for."
        },
        "ideaToCode.models.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "The address of a custom OpenAI-compatible endpoint. User settings only, so a project can't redirect your key."
        },
        "ideaToCode.models.tiers": {
          "type": "object",
          "default": {},
          "scope": "application",
          "description": "The main and small model chosen for each provider."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "ideaToCode.mcp",
        "label": "idea-to-code"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node esbuild.mjs",
    "test:ext": "tsx scripts/run-ext-tests.ts",
    "export-sample": "tsx scripts/export-sample.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.93",
    "@ai-sdk/google": "4.0.109",
    "@ai-sdk/openai": "4.0.106",
    "@ai-sdk/openai-compatible": "3.0.82",
    "@idea-to-code/core": "workspace:*",
    "@idea-to-code/store": "workspace:*",
    "ai": "7.0.158",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@idea-to-code/webview": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "idea-to-code-mcp": "workspace:*",
    "tsx": "4.23.15"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode plans are view-only and no history is recorded. Trust the folder to turn everything on."
    }
  }
}
