{
  "name": "idea-to-code-mcp",
  "version": "1.0.1",
  "type": "module",
  "description": "MCP server for idea-to-code plans: plan software as nested flowcharts with any coding agent.",
  "license": "MIT",
  "author": "Oyinlola Ojelere",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oyinlola007/idea-to-code.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/oyinlola007/idea-to-code/tree/main/packages/mcp#readme",
  "bugs": "https://github.com/oyinlola007/idea-to-code/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "planning",
    "flowchart",
    "claude-code",
    "cursor",
    "copilot",
    "vscode"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "idea-to-code-mcp": "./dist/main.js"
  },
  "files": [
    "dist/main.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node esbuild.mjs",
    "smoke": "node esbuild.mjs && tsx scripts/smoke.ts",
    "claude-check": "node esbuild.mjs && tsx scripts/claude-check.ts"
  },
  "devDependencies": {
    "@idea-to-code/core": "workspace:*",
    "@idea-to-code/store": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "esbuild": "0.28.2",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json"
    },
    "access": "public"
  }
}
